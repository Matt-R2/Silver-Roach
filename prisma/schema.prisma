// Prisma schema. Auth users live in Supabase's auth.users table — we only store
// the Supabase user id (a uuid) as `userId` and scope all rows to it in app code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled connection (PgBouncer) for queries
  directUrl = env("DIRECT_URL")     // direct connection for migrations
}

model Holding {
  id         String    @id @default(uuid())
  userId     String
  symbol     String // AU, AG, PT, PD, RH, CU, NI, AL, PB, ZN
  weight     Float // weight per piece
  unit       String // ozt, g, kg
  quantity   Int       @default(1) // number of pieces; total weight = weight * quantity
  purity     Float     @default(1) // fraction 0-1 of fine metal content (24k gold / .999 fine = 1)
  nickname   String? // optional suffix shown after the metal name, e.g. "Coins"
  note       String? // optional free-text note, only shown when editing
  paid       Float? // optional total amount paid, in account currency
  acquiredAt DateTime? // optional date the holding was acquired
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model MetalPriceSnapshot {
  id       String   @id @default(uuid())
  symbol   String // AU, AG, PT, PD, RH, CU, NI, AL, PB, ZN
  priceUsd Float // spot price per troy oz at takenAt
  takenAt  DateTime @default(now())

  @@index([symbol, takenAt])
}

model MetalSpotCache {
  symbol    String   @id // AU, AG, PT, PD, RH, CU, NI, AL, PB, ZN
  priceUsd  Float
  updatedAt DateTime @updatedAt
}

model MetalPointsCache {
  symbol    String   @id // AU, AG, PT, PD, RH, CU, NI, AL, PB, ZN
  p30Usd    Float?
  p1yUsd    Float?
  updatedAt DateTime @updatedAt
}
